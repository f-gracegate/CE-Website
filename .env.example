# Sermon Companion (server-side only). Without it the companion shows an "offline" message.
GEMINI_API_KEY=""
# Optional: override the Gemini model
# GEMINI_MODEL="gemini-3.5-flash"

# Google Maps for the campus finder (browser key, restrict it to your domain)
NEXT_PUBLIC_GOOGLE_MAPS_PLATFORM_KEY=""

# Firebase web app config for Google sign-in. Leave empty to use the built-in simulated sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Public URL of the site (used for social preview links)
NEXT_PUBLIC_SITE_URL=""
